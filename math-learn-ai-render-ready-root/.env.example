# Keep real values in Render Environment Variables. Do not commit a real .env file.
ADMIN_PASSWORD=choose-a-long-unique-admin-password
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the project's publishable key (sb_publishable_...) or legacy anon key. Safe for frontend use.
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Secret/server-side key only. Never place this key in HTML or expose it to students.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=mathspark-documents
# Optional: GEMINI_API_KEY=...
